{
  "rules": {
    "rooms": {
      "$pin": {
        ".read": true,
        ".write": true,
        ".validate": "$pin.matches(/^[0-9]{6}$/)",

        "meta": {
          "createdAt": { ".validate": "newData.isNumber()" },
          "currentRound": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3" },
          "status": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "timer": {
            "durationSeconds": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600" },
            "remainingMs": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 7200000)" },
            "endsAt": { ".validate": "newData.val() == null || newData.isNumber()" },
            "running": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },

        "teams": {
          "$teamId": {
            "teamName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "drafts": {
          "$round": {
            ".validate": "$round == '1' || $round == '2' || $round == '3'",
            "$teamId": {
              "assignments": {
                "$areaId": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 5)" }
              },
              "updatedAt": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          }
        },

        "submissions": {
          "$round": {
            ".validate": "$round == '1' || $round == '2' || $round == '3'",
            "$teamId": {
              "assignments": {
                "$areaId": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 5)" }
              },
              "submittedAt": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          }
        },

        "$other": { ".validate": false }
      }
    },

    "sessions": {
      ".read": true,
      ".write": true
    },
    "presence": {
      ".read": true,
      ".write": true
    }
  }
}
